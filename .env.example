# Copy to .env. Loaded by tpdk_overlay.config at startup.
# Any config key can be overridden with TPDK__<SECTION>__<KEY> (nesting with "__").
GEMINI_API_KEY=

# Default ASR on this workstation: llama_cpp (local llama serve, GGUF).
# Start the server first: powershell -File scripts\serve_asr_llama.ps1
TPDK__ASR__BACKEND=llama_cpp
TPDK__ASR__LLAMA_CPP__BASE_URL=http://127.0.0.1:8081

# vLLM service in WSL (report path): TPDK__ASR__BACKEND=http
TPDK__ASR__BASE_URL=http://127.0.0.1:8000

TPDK__SERVER__PORT=8765
